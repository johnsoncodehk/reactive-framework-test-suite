{
  "name": "reactive-framework-test-suite",
  "version": "0.0.2",
  "description": "Cross-framework test suite for reactive signal libraries: propagation, batching, disposal, error handling and other edge cases.",
  "keywords": [
    "signals",
    "reactivity",
    "reactive",
    "test-suite",
    "computed",
    "effect"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnsoncodehk/reactive-framework-test-suite.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/update-readme.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@amadeus-it-group/tansu": "^2.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@preact/signals-core": "^1.8.0",
    "@reactively/core": "^0.0.8",
    "@reatom/core": "^1001.0.0",
    "@solidjs/signals": "^0.3.0",
    "@types/node": "^22.20.4",
    "@vue/reactivity": "^3.5.0",
    "alien-signals": "^3.2.1",
    "anod": "^0.9.1",
    "mobx": "^6.13.0",
    "pota": "^0.7.0",
    "s-js": "^0.4.9",
    "signal-polyfill": "^0.2.2",
    "solid-js": "^1.9.0",
    "svelte": "^5.34.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
